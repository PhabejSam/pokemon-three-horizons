    goto TH_Rival_BRIDGE_After

TH_Rival_Bridge::
    lockall
    goto_if_set FLAG_TH_BRIDGE_RIVAL, TH_Rival_BRIDGE_After
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_BULBASAUR, TH_Rival_BRIDGE_Bulbasaur
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_CHARMANDER, TH_Rival_BRIDGE_Charmander
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_SQUIRTLE, TH_Rival_BRIDGE_Squirtle
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_CHIKORITA, TH_Rival_BRIDGE_Chikorita
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_CYNDAQUIL, TH_Rival_BRIDGE_Cyndaquil
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_TOTODILE, TH_Rival_BRIDGE_Totodile
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_TREECKO, TH_Rival_BRIDGE_Treecko
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_TORCHIC, TH_Rival_BRIDGE_Torchic
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_MUDKIP, TH_Rival_BRIDGE_Mudkip
    msgbox TH_Rival_NotReady
    release
    end
TH_Rival_BRIDGE_Victory::
    setflag FLAG_TH_BRIDGE_RIVAL
    call TH_ChapterCheck
TH_Rival_BRIDGE_After:
    msgbox TH_Rival_BRIDGE_AfterText
    releaseall
    end

TH_Rival_NotReady:
    .string "Choose a partner at the lab first.\nThen we can have a proper battle!$"

TH_Rival_ROUTE22_Intro:
    .string "{RIVAL}: Heading for the League?\nLet us see how our partners grew!$"

TH_Rival_ROUTE22_Defeat:
    .string "You got me!\nI had better keep training.$"

TH_Rival_ROUTE22_AfterText:
    .string "{RIVAL}: I will try the route east\nof PEWTER next. See you there!$"

TH_Rival_BRIDGE_Intro:
    .string "{RIVAL}: You crossed MT. MOON too!\nOur partners have come a long way.\pBefore you take on the bridge,\nlet us put our teams to the test!$"

TH_Rival_BRIDGE_Defeat:
    .string "That was a great battle!\nWe both have grown stronger.$"

TH_Rival_BRIDGE_AfterText:
    .string "{RIVAL}: I will scout the road ahead.\nEnjoy CERULEAN while you are here!$"

TH_Rival_BridgeTrigger::
    lockall
    applymovement OBJ_EVENT_ID_PLAYER, TH_BridgeFaceUp
    waitmovement 0
    goto_if_set FLAG_TH_BRIDGE_RIVAL, TH_ChapterEnd
    setvar VAR_LAST_TALKED, LOCALID_TH_CERULEAN_7
    goto TH_Rival_Bridge
TH_MistyVictory::
    setflag FLAG_BADGE02_GET
TH_MistyReward:
    goto_if_set FLAG_TH_MISTY_TM, TH_MistyAfterReward
    giveitem ITEM_TM_WATER_PULSE
    goto_if_eq VAR_RESULT, FALSE, TH_MistyBagFull
    setflag FLAG_TH_MISTY_TM
TH_MistyAfterReward:
    msgbox TH_MistyThanks
    call TH_ChapterCheck
    releaseall
    end
TH_MistyBagFull:
    msgbox TH_MistyFull
    releaseall
    end
TH_ChapterCheck:
    special TH_ScriptCheckChapter
    goto_if_eq VAR_RESULT, FALSE, TH_ChapterReturn
    msgbox TH_ChapterComplete
TH_ChapterReturn:
    return
TH_ChapterEnd:
    releaseall
    end

TH_MistyThanks:
    .string "MISTY: The CASCADEBADGE is yours!\nWATER PULSE is a reusable TM.\pThe caretaker outside has news\nabout a partner from another region.$"

TH_MistyFull:
    .string "Your badge is safe. Make room\nfor WATER PULSE and speak to me again.$"

TH_ChapterComplete:
    .string "You have completed this chapter!\nTwo badges and a reunion with {RIVAL}.\pKeep exploring, catching, and training.\nThe road beyond the bridge comes next!$"

