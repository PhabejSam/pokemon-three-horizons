TH_Rival_Route22::
    lock
    faceplayer
    goto_if_set FLAG_TH_ROUTE22_RIVAL, TH_Rival_ROUTE22_After
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_BULBASAUR, TH_Rival_ROUTE22_Bulbasaur
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_CHARMANDER, TH_Rival_ROUTE22_Charmander
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_SQUIRTLE, TH_Rival_ROUTE22_Squirtle
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_CHIKORITA, TH_Rival_ROUTE22_Chikorita
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_CYNDAQUIL, TH_Rival_ROUTE22_Cyndaquil
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_TOTODILE, TH_Rival_ROUTE22_Totodile
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_TREECKO, TH_Rival_ROUTE22_Treecko
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_TORCHIC, TH_Rival_ROUTE22_Torchic
    goto_if_eq VAR_TH_RIVAL_PARTNER, SPECIES_MUDKIP, TH_Rival_ROUTE22_Mudkip
    msgbox TH_Rival_NotReady
    release
    end
TH_Rival_ROUTE22_Victory::
    setflag FLAG_TH_ROUTE22_RIVAL
TH_Rival_ROUTE22_After:
    msgbox TH_Rival_ROUTE22_AfterText
    releaseall
    end

