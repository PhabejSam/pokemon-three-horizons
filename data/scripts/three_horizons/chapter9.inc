TH_Fossil_Dome::
    lock
    faceplayer
    goto_if_set FLAG_TH_FOSSIL, TH_FossilTaken
    goto_if_defeated TRAINER_TH9_SUPER_NERD_MIGUEL, TH_FossilChooseDome
    msgbox TH_FossilBattleFirst
    release
    end
TH_FossilChooseDome:
    msgbox TH_FossilDomeOffer, MSGBOX_YESNO
    goto_if_eq VAR_RESULT, NO, TH_PickupDone
    giveitem ITEM_DOME_FOSSIL
    goto_if_eq VAR_RESULT, FALSE, TH_PickupFull
    setflag FLAG_TH_FOSSIL
    setflag FLAG_TH_FOSSIL_DOME
    removeobject VAR_LAST_TALKED
    msgbox TH_FossilKeepSafe
    release
    end

TH_FossilDomeOffer:
    .string "Take the DOME FOSSIL?\nYou may choose only one.$"

